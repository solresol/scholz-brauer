import ScholzBrauer.Clift109Halving

/-! Odd-run pruning for the interval remainder. Runs are the connected
components of the integer weights under edges of length `d`. Pairing a weight
with its translate keeps both endpoints in one component. Consequently each
odd component must consume at least one exceptional weight. -/

namespace ScholzBrauer.Clift109

/-- The equivalence classes generated by steps whose two endpoints occur in
the multiset. For positive `d`, its classes meeting the support are exactly
the maximal arithmetic runs of step `d`, including singleton runs. -/
def runSetoid (d : ℤ) (s : Multiset ℤ) : Setoid ℤ :=
  Relation.EqvGen.setoid (fun x y => x ∈ s ∧ y ∈ s ∧ y = x + d)

def runClass (d : ℤ) (s : Multiset ℤ) (x : ℤ) : Quotient (runSetoid d s) :=
  Quotient.mk _ x

noncomputable local instance (d : ℤ) (s : Multiset ℤ) :
    DecidableEq (Quotient (runSetoid d s)) := Classical.decEq _

theorem runClass_step (d : ℤ) (s : Multiset ℤ) (x : ℤ)
    (hx : x ∈ s) (hxd : x + d ∈ s) :
    runClass d s (x + d) = runClass d s x := by
  apply Eq.symm
  exact Quotient.sound (Relation.EqvGen.rel _ _ ⟨hx, hxd, rfl⟩)

/-- Count components of odd weight multiplicity. On duplicate-free input,
this counts precisely the odd-length maximal runs. -/
noncomputable def oddRunCount (d : ℤ) (s : Multiset ℤ) : ℕ := by
  classical
  let classes := s.map (runClass d s)
  exact (classes.toFinset.filter (fun q => classes.count q % 2 = 1)).card

/-- A label constant across all paired edges receives an even contribution
from the paired part; its parity is therefore exactly that of the exceptions. -/
theorem paired_class_count {α : Type*} [DecidableEq α]
    (d : ℤ) (a e : Multiset ℤ) (f : ℤ → α)
    (hf : ∀ x ∈ a, f (x + d) = f x) (q : α) :
    ((zbranch a d + e).map f).count q =
      2 * (a.map f).count q + (e.map f).count q := by
  have hm : (zshift a d).map f = a.map f := by
    simp only [zshift, Multiset.map_map]
    exact Multiset.map_congr rfl hf
  simp only [zbranch, Multiset.map_add, hm, Multiset.count_add]
  omega

/-- Every odd component of a translated double plus exceptions contains an
exception. This statement retains multiplicities and permits signed weights. -/
theorem odd_run_has_exception (d : ℤ) (a e : Multiset ℤ)
    (q : Quotient (runSetoid d (zbranch a d + e)))
    (hq : ((zbranch a d + e).map (runClass d (zbranch a d + e))).count q % 2 = 1) :
    q ∈ e.map (runClass d (zbranch a d + e)) := by
  classical
  have hf : ∀ x ∈ a,
      runClass d (zbranch a d + e) (x + d) = runClass d (zbranch a d + e) x := by
    intro x hx
    apply runClass_step
    · exact Multiset.mem_add.mpr (Or.inl (Multiset.mem_add.mpr (Or.inl hx)))
    · apply Multiset.mem_add.mpr ∘ Or.inl ∘ Multiset.mem_add.mpr ∘ Or.inr
      exact Multiset.mem_map.mpr ⟨x, hx, rfl⟩
  have hc := paired_class_count d a e (runClass d (zbranch a d + e)) hf q
  apply Multiset.count_pos.mp
  omega

/-- The number of odd runs is bounded by the number of exceptional weights,
before deleting any exceptions. No finite enumeration or search is assumed. -/
theorem oddRunCount_le_exceptions (d : ℤ) (a e : Multiset ℤ) :
    oddRunCount d (zbranch a d + e) ≤ e.card := by
  classical
  unfold oddRunCount
  calc
    _ ≤ (e.map (runClass d (zbranch a d + e))).toFinset.card := by
      apply Finset.card_le_card
      intro q hq
      exact Multiset.mem_toFinset.mpr
        (odd_run_has_exception d a e q (Finset.mem_filter.mp hq).2)
    _ ≤ e.card := by
      simpa using Multiset.toFinset_card_le (e.map (runClass d (zbranch a d + e)))

/-- The parity of the number of odd components is the parity of the total
number of weights. This does not require a pairing or distinct weights. -/
theorem oddRunCount_mod_two (d : ℤ) (s : Multiset ℤ) :
    oddRunCount d s % 2 = s.card % 2 := by
  classical
  let m := s.map (runClass d s)
  have hp (t : Finset (Quotient (runSetoid d s))) :
      (t.filter (fun q => m.count q % 2 = 1)).card % 2 =
        (∑ q ∈ t, m.count q) % 2 := by
    induction t using Finset.induction_on with
    | empty => simp
    | @insert q t hqt ih =>
      rw [Finset.sum_insert hqt, Finset.filter_insert]
      by_cases hq : m.count q % 2 = 1
      · rw [if_pos hq, Finset.card_insert_of_notMem
          (fun h => hqt (Finset.mem_filter.mp h).1)]
        omega
      · rw [if_neg hq]
        omega
  have h := hp m.toFinset
  rw [Multiset.toFinset_sum_count_eq] at h
  simpa [oddRunCount, m] using h

/-- Without exceptions every component of a translated double is even. -/
theorem oddRunCount_zbranch (d : ℤ) (a : Multiset ℤ) :
    oddRunCount d (zbranch a d) = 0 := by
  have h := oddRunCount_le_exceptions d a 0
  simpa using h

/-- Both remainder factorizations force at most seven odd runs. -/
theorem remainder_odd_runs (c : GaugeCoordinates) :
    oddRunCount c.d1 (coordinateRemainder c) ≤ 7 ∧
    oddRunCount c.u (coordinateRemainder c) ≤ 7 ∧
    oddRunCount c.d1 (coordinateRemainder c) % 2 = 1 ∧
    oddRunCount c.u (coordinateRemainder c) % 2 = 1 := by
  have hs := oddRunCount_le_exceptions c.d1 (sinkHalf c) (sinkExceptions c)
  have ht := oddRunCount_le_exceptions c.u (sourceHalf c) (zshift (rem5 c) c.A3)
  rw [← remainder_sink_factor, card_sinkExceptions] at hs
  rw [← remainder_source_factor, card_sourceExceptions] at ht
  have hc : (coordinateRemainder c).card = 45 := by
    rw [remainder_sink_factor]
    simp [zbranch, zshift, card_sinkHalf, card_sinkExceptions]
  exact ⟨hs, ht, by rw [oddRunCount_mod_two, hc],
    by rw [oddRunCount_mod_two, hc]⟩

/-- The pruning applies to the interval minus the box BEFORE deleting either
seven-weight exceptional set. The interval hypothesis ensures no repetitions. -/
theorem interval_odd_runs (c : GaugeCoordinates)
    (h : coordinateWeights c = (Multiset.range 109).map Int.ofNat) :
    let s := (Multiset.range 109).map Int.ofNat - coordinateBox c
    s.Nodup ∧ oddRunCount c.d1 s ≤ 7 ∧ oddRunCount c.u s ≤ 7 ∧
      oddRunCount c.d1 s % 2 = 1 ∧ oddRunCount c.u s % 2 = 1 := by
  dsimp only
  rw [← h]
  simp only [coordinateWeights, add_tsub_cancel_left]
  have hnd : (coordinateWeights c).Nodup := by
    rw [h]
    exact (Multiset.nodup_range 109).map Int.ofNat_injective
  exact ⟨(Multiset.nodup_add.mp hnd).2.1, remainder_odd_runs c⟩

/-- Every hypothetical budget-108 natural labelling obeys BOTH odd-run bounds
and their parity restrictions, with positive steps and duplicate-free input. -/
theorem odd_runs_of_budget (B a b cap : ℕ → ℕ) (h1 : B 1 = 1)
    (hsteps : ∀ s ∈ selectedSteps,
      B s.1 * 2 ^ a (s.1 + s.2) + B s.2 * 2 ^ b (s.1 + s.2) = B (s.1 + s.2))
    (hcap : ∀ s ∈ selectedSteps, a (s.1 + s.2) ≤ cap s.1 ∧ b (s.1 + s.2) ≤ cap s.2)
    (h109 : B 109 = 2 ^ 109 - 1)
    (hbudget : cap 1 + cap 2 + cap 4 + cap 5 + cap 7 + cap 8 + cap 15 +
      cap 23 + cap 28 + cap 51 + cap 58 ≤ 108) :
    let c := minimumCoordinates (fun i => a i) (fun i => b i)
    let s := (Multiset.range 109).map Int.ofNat - coordinateBox c
    0 < c.u ∧ 0 < c.d1 ∧ s.Nodup ∧
      oddRunCount c.d1 s ≤ 7 ∧ oddRunCount c.u s ≤ 7 ∧
      oddRunCount c.d1 s % 2 = 1 ∧ oddRunCount c.u s % 2 = 1 := by
  have hp := halving_of_budget B a b cap h1 hsteps hcap h109 hbudget
  exact ⟨hp.1, hp.2.1, interval_odd_runs _
    (normalized_interval_of_budget B a b cap h1 hsteps hcap h109 hbudget)⟩

end ScholzBrauer.Clift109
