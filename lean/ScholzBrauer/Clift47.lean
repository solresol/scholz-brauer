import ScholzBrauer.Exclusion

/-! The Mersenne seed used in Clift's counterexamples to universal equality.
Source: https://www.additionchains.com/ExactScholz.html
-/
namespace ScholzBrauer.Clift47

/-- Clift's published seed, with successive doublings grouped. -/
def seedSteps : List Step :=
  [(1, 1), (2, 1)] ++ doublingSteps 3 3 ++ [(24, 6)] ++ doublingSteps 30 4 ++
    [(480, 3), (483, 480)] ++ doublingSteps 963 3 ++
    [(7704, 483), (8187, 2), (8189, 8187)] ++ doublingSteps 16376 10 ++
    [(16769024, 8189), (16777213, 2), (16777215, 16777213)] ++
    doublingSteps 33554428 22 ++ [(140737471578112, 16777215)]

/-- The expected values, in the same order as the replay. -/
def seed : List ℕ := 1 :: seedSteps.map (fun (a, b) => a + b)

theorem seed_replay : replay seedSteps = some seed := by decide +kernel

/-- The seed reaches the claimed endpoint in 54 additions and retains the
shifted 11-block and unshifted 24-block used in the later construction. -/
theorem seed_properties :
    seed.getLast? = some (2 ^ 47 - 1) ∧ seedSteps.length = 54 ∧
      2 ^ 3 * (2 ^ 11 - 1) ∈ seed ∧ 2 ^ 24 - 1 ∈ seed := by
  decide +kernel

