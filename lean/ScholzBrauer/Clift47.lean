private theorem exclusion47_checked : checkExclusion exclusion47 47 [1] 1 7 62 = true := by
  decide +kernel

theorem length47_eq_eight : additionChainLength 47 = 8 := by
  let c : List ℕ := [1, 2, 3, 4, 7, 10, 20, 27, 47]
  have hc : IsAdditionChain c := by decide
  have hne := additionChainSteps_nonempty (n := 47) (r := 8) c hc rfl rfl
  have hlo := checkExclusion_lower_bound exclusion47_checked hne
  have hhi := additionChainLength_le (n := 47) (r := 8) c hc rfl rfl
  omega

theorem scholz47 : additionChainLength (2 ^ 47 - 1) ≤ 47 - 1 + additionChainLength 47 := by
  rw [length47_eq_eight]
  simpa only [seed_properties.2.1] using replay_upper_bound seed_replay seed_properties.1

-- Generated by the same checker input generator for target 11 and budget 4.
private def exclusion11 : Array ExclusionNode :=
  #[.gap, .split [(6, 0)], .split [(6, 0), (8, 0)], .split [(3, 1), (4, 2)], .split [(2, 3)]]

private theorem exclusion11_checked : checkExclusion exclusion11 11 [1] 1 4 4 = true := by
  decide

/-- No chain for 47 using at most eight additions stores both exponent seeds. -/
theorem not_mem_11_and_24 {c : List ℕ} (hc : IsAdditionChain c)
    (hlast : c.getLast? = some 47) (hlen : c.length ≤ 9) :
    ¬ (11 ∈ c ∧ 24 ∈ c) := by
  rintro ⟨h11, h24⟩
  obtain ⟨p, s, rfl⟩ := List.mem_iff_append.mp h11
  have hp : IsAdditionChain (p ++ [11]) :=
    IsAdditionChain.prefix (s := s) (by simpa [List.append_assoc] using hc) (by simp)
  have hp11 := endpoint_properties hp (show (p ++ [11]).getLast? = some 11 by simp)
  have hpl : 5 ≤ p.length := by
    by_contra! h
    exact checkExclusion_excludes exclusion11_checked hp (by simp) (by
      simpa using (show p.length ≤ 4 by omega))
  have h24s : 24 ∈ s := by
    rcases List.mem_append.mp h24 with h | h
    · have := hp11.2 24 (List.mem_append_left _ h)
      omega
    · simpa using h
  obtain ⟨q, r, rfl⟩ := List.mem_iff_append.mp h24s
  have hrne : r ≠ [] := by
    rintro rfl
    have he : p ++ 11 :: (q ++ [24]) = (p ++ 11 :: q) ++ [24] := by
      rw [List.append_assoc, List.cons_append]
    rw [he, List.getLast?_concat] at hlast
    exact (by decide : (24 : ℕ) ≠ 47) (Option.some.inj hlast)
  have hqne : q ≠ [] := by
    rintro rfl
    have hp' : IsAdditionChain ((p ++ [11]) ++ [24]) :=
      IsAdditionChain.prefix (s := r) (by simpa [List.append_assoc] using hc) (by simp)
    have hreach : ChainReach 24 (p ++ [11]) 11 1 :=
      additionChain_extension_reaches hp' (by simp) (by simp)
    have := hreach.doubling_bound hp11.2
    omega
  simp only [List.length_append, List.length_cons] at hlen
  have hqpos := List.length_pos_iff.mpr hqne
  have hrpos := List.length_pos_iff.mpr hrne
  have hq : q.length = 1 := by omega
  have hr : r.length = 1 := by omega
  obtain ⟨v, rfl⟩ := List.length_eq_one_iff.mp hq
  obtain ⟨w, rfl⟩ := List.length_eq_one_iff.mp hr
  have hw : w = 47 := by simpa using hlast
  subst w
  have hvchain : IsAdditionChain ((p ++ [11]) ++ [v]) :=
    IsAdditionChain.prefix (s := [24, 47]) (by simpa [List.append_assoc] using hc) (by simp)
  have hreach : ChainReach v (p ++ [11]) 11 1 :=
    additionChain_extension_reaches hvchain (by simp) (by simp)
  have hv := hreach.doubling_bound hp11.2
  obtain ⟨a, ha, b, hb, hab⟩ := hc.2.2 47 (by simp) (by decide)
  have ha' := hc.one_le_of_mem ha
  have hb' := hc.one_le_of_mem hb
  have hsmall (x : ℕ) (hx : x ∈ p ++ 11 :: ([v] ++ 24 :: [47])) (hlt : x < 47) :
      x ≤ 22 ∨ x = 24 := by
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with hx | rfl | rfl | rfl | rfl
    · have := hp11.2 x (List.mem_append_left _ hx)
      omega
    all_goals omega
  rcases hsmall a ha (by omega) with ha | rfl <;>
    rcases hsmall b hb (by omega) with hb | rfl <;> omega

/-- The nine-addition lower bound for storing both exponents is sharp. -/
theorem nine_step_source_with_seeds :
    ∃ c : List ℕ, IsAdditionChain c ∧ c.getLast? = some 47 ∧
      c.length = 10 ∧ 11 ∈ c ∧ 24 ∈ c := by
  refine ⟨[1, 2, 3, 5, 10, 11, 12, 23, 24, 47], ?_⟩
  decide

